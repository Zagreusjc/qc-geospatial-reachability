# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data artifacts (large / regenerable) -- keep folders via .gitkeep, ignore contents
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Pipeline outputs (regenerable, large) -- figures, tables and maps are committed
outputs/models/*
outputs/embeddings/*
!outputs/models/.gitkeep
!outputs/embeddings/.gitkeep

# Common geo/data file types (in case they land outside data/)
*.gpkg
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.pbf
*.parquet
*.npz
*.npy
*.pt
*.pth
*.gpickle
*.emb
*.edg

# OS / editor
.DS_Store
*.log

# Archived local experiment runs (large, regenerable, not meant for the repo)
runs_archive/

# Local-only notes (never pushed -- see the file itself for why)
*.local.md
